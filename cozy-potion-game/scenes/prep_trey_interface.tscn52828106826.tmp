[sub_resource type="GDScript" id="GDScript_f55em"]
script/source = "extends Node

@onready var storage: HBoxContainer = $Control/HBoxContainer

var held_stacks : Array[Stack] = []
var max_hand_size : int

func _ready() -> void:
	max_hand_size = 1


# Spawns slots for prep tray
func spawn_all_slots() -> void:
	
	for stack in held_stacks:
		var new_instance := ItemSlot.item_slot_scene.instantiate()
		storage.add_child(new_instance)
		
		new_instance.gui_input.connect(entry_clicked.bind(new_instance))
		new_instance.stack = stack

func entry_clicked(event: InputEvent, slot: ItemSlot) -> void:
	pass
"

